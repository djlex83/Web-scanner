{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-scanner",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    // Alles außer /api/* liefert die React-App aus; unbekannte Pfade → index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // Ohne database_id legt "wrangler deploy" die Datenbank beim ersten Mal selbst an.
      "binding": "DB",
      "database_name": "web-scanner"
    }
  ],
  "vars": {
    // Passwort-Hashing-Runden; 20000 passt in den kostenlosen Tarif (10 ms CPU je Anfrage)
    "PBKDF2_RUNDEN": "20000"
  },
  "observability": { "enabled": true }
}
